# Trading_Agent API base URL
#   本機開發:http://localhost:8000
#   Zeabur(同 project):http://api.zeabur.internal:8080
#   AWS / 其他平台:該平台的內網或公網 URL
MCP_API_BASE_URL=http://localhost:8000

# Service-to-service bearer token —— MCP server 打 Trading_Agent API 時用
MCP_API_AUTH_TOKEN=replace-with-real-token

# Client bearer token —— Claude.ai / Desktop / 其他 MCP client 打本 server 時要帶
MCP_BEARER_TOKEN=replace-with-real-token

# Streamable HTTP transport port(Zeabur 會用 $PORT 蓋過)
PORT=8000
