# Trading_Agent API base URL
#   本機開發:http://localhost:8000
#   Zeabur(同 project):http://api.zeabur.internal:8080
#   AWS / 其他平台:該平台的內網或公網 URL
MCP_API_BASE_URL=http://localhost:8000

# Service-to-service bearer token —— MCP server 打 Trading_Agent API 查資料時用。
MCP_API_AUTH_TOKEN=replace-with-real-token

# ============================================================
# OAuth 2.1(Google 上游)—— 主線認證路徑
#
# 設好之後,使用者只要 `claude mcp add <url>`:client 自己讀 .well-known 發現
# 授權伺服器 → 彈瀏覽器用 Google 登入 → 自動拿到 access + refresh token →
# 過期自動續。**完全不必手動複製貼上 API key。**
#
# 這三個 + MCP_SAAS_DATABASE_URL 四者齊全才啟用;缺任一個就靜靜退回下面的
# bearer API key 模式,server 不會 crash。
#
# ⚠️ GCP 那邊要做的事(在 Google Cloud Console → APIs & Services → Credentials):
#    1. 建一個 OAuth 2.0 Client ID,類型選 **Web application**。
#    2. 在「Authorized redirect URIs」加入 **<MCP_PUBLIC_BASE_URL>/auth/callback**
#       (逐字,含 https;例如 https://mcp.livermore.club/auth/callback)。
#       少了這一條 Google 會在授權最後一步直接拒絕(redirect_uri_mismatch)。
#
# ℹ️ 不需要額外的簽章 / 加密金鑰環境變數:FastMCP JWT 的 signing key 與 OAuth
#    狀態儲存的加密金鑰都從 client secret **決定性推導**,跨 pod / 跨 redeploy
#    自動一致。代價是輪替 client secret 會讓既有 OAuth session 全部失效
#    (使用者重新授權一次即可)。
# ============================================================

# 對外可達的 base URL(無尾斜線)。OAuth 的 issuer、metadata 位址與 Google
# redirect URI 全部由它推導。留空 = 不啟用 OAuth。
# MCP_PUBLIC_BASE_URL=https://mcp.livermore.club

# GCP OAuth 2.0 Client(Web application)的憑證。
# MCP_GOOGLE_CLIENT_ID=<xxx>.apps.googleusercontent.com
# MCP_GOOGLE_CLIENT_SECRET=GOCSPX-<xxx>

# Per-user 認證(SaaS 模式)。
#   true  → 每個 user 帶自己的 API key,由 MCP server 直接對 SaaS 控制面 DB 驗證
#           (需要 MCP_SAAS_DATABASE_URL);此時 MCP_BEARER_TOKEN 可留空。
#   false → 退回單一共用 MCP_BEARER_TOKEN(本機 / 舊行為,預設)。
MCP_PER_USER_AUTH=false

# Client bearer token —— 單一共用 token 模式下,client 打本 server 要帶。
# per-user 模式(MCP_PER_USER_AUTH=true)下留空即可。
MCP_BEARER_TOKEN=replace-with-real-token

# SaaS 控制面 DB(api_keys / subscriptions / usage_events / users)。
# per-user 認證的唯一資料來源:驗 key、判 tier、算額度、寫用量。
# **OAuth 模式也需要它**:把 Google 身分 upsert 進 users,以及存 OAuth 狀態
# (client 註冊 / 上游 token / code / JTI,表名 mcp_oauth_state,自動建表)。
# asyncpg 風格,不要 `+asyncpg` 後綴:postgresql://user:pw@host:port/db
# ⚠️ 需要「讀 + 寫」:SELECT api_keys / subscriptions / usage_events、
#    INSERT usage_events、UPDATE api_keys.last_used_at —— 所以**不能**沿用
#    MCP_READONLY_DB_DSN 的唯讀 role(那個只給 execute_readonly_sql tool 用,
#    兩個變數用途不同、權限不同,並存)。
# 留空 = 停用 per-user 模式(退回共用 token)。
# MCP_SAAS_DATABASE_URL=postgresql://<user>:<pw>@<host>:<port>/<db>

# (選填)per-user 認證的三個快取 TTL(秒)。
#   MCP_AUTH_CACHE_TTL   驗證成功後多久內不再查 DB(預設 300)。
#                        取捨:key 撤銷最多延遲這麼久生效。
#   MCP_AUTH_STALE_TTL   DB 不可用時沿用舊快取的上限(預設 3600)。
#   MCP_QUOTA_CACHE_TTL  額度狀態的快取秒數(預設 60)。
# MCP_AUTH_CACHE_TTL=300
# MCP_AUTH_STALE_TTL=3600
# MCP_QUOTA_CACHE_TTL=60

# Streamable HTTP transport port(Zeabur 會用 $PORT 蓋過)
PORT=8000
